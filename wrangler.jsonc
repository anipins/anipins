{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anipins-staging",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "AniPinsContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ANIPINS_CONTAINER",
        "class_name": "AniPinsContainer"
      }
    ]
  },
  "exports": {
    "AniPinsContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
