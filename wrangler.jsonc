{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anipins-staging",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "vars": {
    "D1_RPC_URL": "https://anipins.com/__internal/d1",
    "BETTER_AUTH_GOOGLE_CLIENT_ID": "903834125575-h61hfmqa5l32rbun2k3tg40ab657nbut.apps.googleusercontent.com",
    "CONTAINER_INSTANCE": "basic"
  },
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "AniPinsContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile",
          "build_vars": {
            "NEXT_PUBLIC_AUTH_MODE": "better-auth",
            "NEXT_PUBLIC_BETTER_AUTH_BASE_PATH": "/api/better-auth",
            "NEXT_PUBLIC_GOOGLE_CLIENT_ID": "903834125575-h61hfmqa5l32rbun2k3tg40ab657nbut.apps.googleusercontent.com"
          }
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ANIPINS_CONTAINER",
        "class_name": "AniPinsContainer"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ARTWORKS_PUBLIC",
      "bucket_name": "anipins-public-media"
    },
    {
      "binding": "ARTWORKS_PREMIUM",
      "bucket_name": "anipins-premium-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anipins-production-db",
      "database_id": "5f1923c8-e706-4894-90e7-2d378333a65a",
      "migrations_dir": "migrations/d1"
    }
  ],
  "exports": {
    "AniPinsContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
