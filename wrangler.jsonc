{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anipins-staging",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "AniPinsContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ANIPINS_CONTAINER",
        "class_name": "AniPinsContainer"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ARTWORKS_PUBLIC",
      "bucket_name": "anipins-public-media"
    },
    {
      "binding": "ARTWORKS_PREMIUM",
      "bucket_name": "anipins-premium-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anipins-staging-db",
      "database_id": "47006a2e-45b1-42e4-9f89-5ce8329a44bf",
      "migrations_dir": "migrations/d1"
    }
  ],
  "exports": {
    "AniPinsContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
