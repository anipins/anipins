# Local-only fallbacks use SQLite by default. Production uses Cloudflare Workers,
# D1 and R2. Never put real credentials in this file; use local secret storage or
# `wrangler secret put` for deployed Worker secrets.
DATABASE_URL=                 # Optional local PostgreSQL only; do not combine with D1_RPC_URL
D1_RPC_URL=                   # Internal D1 bridge URL, e.g. https://anipins.com/__internal/d1
D1_RPC_SECRET=                # Secret shared by Worker and container
BETTER_AUTH_SECRET=           # 32+ random bytes; Better Auth Worker secret
BETTER_AUTH_URL=              # Optional exact Better Auth origin for local/staging
NEXT_PUBLIC_AUTH_MODE=better-auth
NEXT_PUBLIC_BETTER_AUTH_BASE_PATH=/api/better-auth
ADMIN_PASSWORD=               # Legacy/setup compatibility only; never use as a public credential
ADMIN_2FA_ENCRYPTION_KEY=      # Dedicated secret for encrypting the administrator authenticator seed
NEXTAUTH_URL=https://anipins.com
NEXTAUTH_SECRET=              # Secret used for legacy session bridge and signed storage capabilities
NEXT_PUBLIC_SITE_URL=https://anipins.com
MEDIA_PROVIDER=r2
R2_PUBLIC_BUCKET=
R2_PREMIUM_BUCKET=
R2_ENDPOINT=                  # Optional S3-compatible endpoint for local tools
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
EMAIL_FROM=
RESEND_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON= # Optional server-only Firebase service account JSON
SETUP_TOKEN=                  # One-time setup endpoint bearer secret
# Google OAuth client ID is public; its client secret is server-only.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SITE_VERIFICATION=     # Search Console HTML verification token
ANDROID_APP_LINKS_SHA256=     # Release certificate SHA-256 fingerprint(s), comma-separated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PREMIUM_PLAN_ID_99_WEEKLY=
RAZORPAY_PREMIUM_PLAN_ID_199=
RAZORPAY_PREMIUM_PLAN_ID_199_MONTHLY=
RAZORPAY_PREMIUM_PLAN_ID_1999_YEARLY=
