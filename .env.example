# Leave all empty for local mode (SQLite + local uploads).
# For production on Vercel, set all three (from your Supabase project):
DATABASE_URL=            # Supabase: Project Settings -> Database -> Connection string (URI, "Transaction" pooler, port 6543)
SUPABASE_URL=            # Supabase: Project Settings -> API -> Project URL
SUPABASE_SERVICE_ROLE_KEY=  # Supabase: Project Settings -> API -> service_role key (KEEP SECRET - server only)
ADMIN_PASSWORD=          # Optional: initial admin password (default AniPins@2026)
FIREBASE_SERVICE_ACCOUNT_JSON= # Optional: enables instant Android push delivery (server-only JSON)
