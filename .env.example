# Leave all empty for local mode (SQLite + local uploads).
# AniPins currently runs on Cloudflare Workers/Containers. Supabase/Postgres variables
# below are legacy runtime dependencies and must remain available until D1 parity/cutover is verified.
DATABASE_URL=            # Legacy PostgreSQL source during migration only; do not set together with D1_RPC_URL
D1_RPC_URL=               # Staging Worker internal D1 bridge endpoint (HTTPS); leave unset until D1 schema/data parity is verified
D1_RPC_SECRET=            # 32+ character random secret shared by the Worker and app Container; never commit a value
BETTER_AUTH_SECRET=       # 32+ character Better Auth secret; staging only until migration and parity checks pass
BETTER_AUTH_URL=          # Exact staging Worker origin for Better Auth callbacks; do not set to production during staging
SUPABASE_URL=            # Supabase: Project Settings -> API -> Project URL
SUPABASE_SERVICE_ROLE_KEY=  # Supabase: Project Settings -> API -> service_role key (KEEP SECRET - server only)
ADMIN_PASSWORD=          # Required before one-time setup; use a unique 12+ character password.
FIREBASE_SERVICE_ACCOUNT_JSON= # Optional: enables instant Android push delivery (server-only JSON)
NEXT_PUBLIC_SITE_URL=https://anipins.com
# Google Identity Services OAuth 2.0 Web client ID. These two values are the same ID.
# GOOGLE_CLIENT_ID is read only by the server; NEXT_PUBLIC_GOOGLE_CLIENT_ID renders Google's button.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=     # Optional server-only OAuth client secret; configure on staging Worker, never expose to browser
GOOGLE_SITE_VERIFICATION= # Optional: Search Console HTML verification token
ANDROID_APP_LINKS_SHA256= # Release certificate SHA-256 fingerprint(s), comma-separated
# Optional: use only if you created a separate ₹199/month Razorpay plan yourself.
# Otherwise AniPins creates and safely stores the ₹199 plan on the first checkout.
RAZORPAY_PREMIUM_PLAN_ID_199=
